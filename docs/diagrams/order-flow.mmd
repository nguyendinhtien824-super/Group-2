    class Start,Success startEnd
    class Input,StandardQueue,PriorityQueue,Await,Permit,Recheck,History,Price,Debit,SaveOrder,SaveTx,Release process
    class ValidInput,PreCustomer,Tier,QueueHead,StateOk,LimitOk,Funds,Stock decision
    class IntakeFail,GuardFail,CommitFail,Failure failure
