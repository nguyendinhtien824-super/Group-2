@startuml
skinparam roundcorner 0
skinparam defaultFontName "Arial"
skinparam titleFontName "Arial"
skinparam shadowing false
skinparam ActivityShape rectangle
skinparam ArrowColor #334155
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #334155
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #334155
skinparam conditionStyle InsideDiamond
skinparam ConditionEndStyle hline

title Luồng Nghiệp Vụ Đặt Hàng (Flash Sale Checkout Flow)

start
:Nhận yêu cầu: itemId, quantity, customerId, voucherCode;
if (Khách hàng có tồn tại?) then ( No )
  :Báo lỗi: Khách hàng không tồn tại;
  stop
endif

if (Trạng thái tài khoản là BANNED?) then ( Yes )
  :Báo lỗi: Tài khoản đã bị khóa;
  stop
endif

:Xác định giới hạn mua theo hạng (maxQty);
if (Số lượng đặt mua > maxQty?) then ( Yes )
  :Báo lỗi: Vượt giới hạn mua mỗi lượt;
  stop
endif

if (Tổng đã mua + Mua mới > Giới hạn sự kiện?) then ( Yes )
  :Báo lỗi: Vượt quá giới hạn mua của sự kiện;
  stop
endif

:Tính đơn giá và tổng phụ (subtotal);
if (Có áp dụng mã Voucher?) then ( Yes )
  if (Voucher hợp lệ & đạt đơn tối thiểu?) then ( Yes )
    :Trừ lượt dùng của Voucher (Synchronized);
  else ( No )
    :Báo lỗi: Voucher không hợp lệ hoặc hết lượt;
    stop
  endif
else ( No )
endif

:Yêu cầu trừ kho sản phẩm;
if (Trừ kho thành công?) then ( Yes )
  :Tạo đơn hàng mới & Chi tiết đơn hàng;
  :Ghi dữ liệu xuống CSV;
  :Dispatch (Điều phối) đơn hàng;
else ( No )
  if (Có áp dụng Voucher?) then ( Yes )
    :Hoàn tác (Rollback) lượt sử dụng Voucher;
  else ( No )
  endif
  :Báo lỗi: Hết hàng hoặc xung đột giao dịch;
  stop
endif
stop
@enduml