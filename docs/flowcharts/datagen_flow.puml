@startuml
skinparam roundcorner 0
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam ActivityShape rectangle
skinparam ArrowColor #334155
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #334155
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam conditionStyle InsideDiamond
skinparam ConditionEndStyle hline

title Luồng Sinh Dữ Liệu CSV (Data Generator Flow)

start
:Khởi chạy DataGeneratorService;
:Tạo hoặc dọn dẹp thư mục "data/";

while (Tổng số dòng < 10.000?) is ( Yes )
  :Sinh/Bổ sung dữ liệu products.csv;
  :Sinh/Bổ sung dữ liệu customers.csv;
  :Sinh/Bổ sung dữ liệu vouchers.csv;
  :Sinh/Bổ sung dữ liệu flash_events, flash_items;
  :Sinh/Bổ sung dữ liệu orders, order_details;
  
  :Tính tổng số dòng dữ liệu hiện tại;
  
  if (Tổng số dòng >= 10.000?) then ( Yes )
    :Ghi nhận trạng thái dữ liệu đủ chuẩn;
  else ( No )
    :Cảnh báo lỗi: Dữ liệu chưa đủ;
  endif
endwhile ( No )

:Lưu tất cả các file CSV xuống ổ đĩa;
:Trả về kết quả báo cáo lên Console;
stop
@enduml