@startuml
skinparam roundcorner 0
skinparam defaultFontName "Arial"
skinparam shadowing false
skinparam ActivityShape rectangle
skinparam ArrowColor #334155
skinparam ActivityBackgroundColor #F8FAFC
skinparam ActivityBorderColor #334155
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam conditionStyle InsideDiamond
skinparam ConditionEndStyle hline

title So Sánh Cơ Chế Đồng Bộ Luồng & Ngăn Race Condition

start
:Nhận yêu cầu trừ kho sản phẩm;

if (Cơ chế là NO_LOCK?) then ( Yes )
  :Đọc tồn kho lên bộ nhớ;
  :Ghi đè số lượng mới xuống CSV (Hậu quả: Âm kho);
else ( No )
  if (Cơ chế là FILE_LOCK?) then ( Yes )
    :Yêu cầu khóa độc quyền (Exclusive Lock);
    :Thực hiện giao dịch;
    :Giải phóng khóa;
  else ( No )
    if (Cơ chế là SYNCHRONIZED?) then ( Yes )
      :Yêu cầu khóa monitor trên đối tượng;
      :Thực hiện giao dịch;
      :Tự động giải phóng khóa;
    else ( Yes: OPTIMISTIC_LOCK )
      repeat
        :Đọc tồn kho và version;
        if (Tồn kho < Số lượng mua?) then ( Yes )
          :Báo lỗi: Hết hàng;
          stop
        else ( No )
        endif
        
        :Kiểm tra version khi cập nhật;
        if (Version khớp ban đầu?) then ( Yes )
          :Ghi đè dữ liệu mới;
        else ( No )
          :Tăng biến đếm thử lại;
        endif
      backward:Thử lại vòng lặp mới;
      repeat while (Giao dịch thành công HOẶC hết lượt retry?) is ( No ) not ( Yes )
    endif
  endif
endif
stop
@enduml